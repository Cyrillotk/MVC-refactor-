<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="stylesheet" href="/style.css">
    <title>Student Details</title>
</head>

<body>

    <h1>Student Details</h1>

    <h2><%= student.name %></h2>

    <p>
        <strong>Age:</strong>
        <%= student.age %>
    </p>

    <p>
        <strong>Course:</strong>
        <%= student.course %>
    </p>

    <p>
        <strong>Email:</strong>
        <%= student.email %>
    </p>

    <br>

    <a href="/students">
        ← Back to Students
    </a>

    |

    <a href="/students/<%= student._id %>/edit">
        Edit Student
    </a>

</body>
</html>