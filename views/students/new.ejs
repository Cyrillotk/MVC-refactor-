<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="stylesheet" href="/style.css">
    <title>Add Student</title>
</head>

<body>

    <h1>Add New Student</h1>

    <form action="/students" method="POST">

        <div>
            <label>Name:</label>

            <input
                type="text"
                name="name"
                required
            >
        </div>

        <br>

        <div>
            <label>Age:</label>

            <input
                type="number"
                name="age"
                min="1"
                required
            >
        </div>

        <br>

        <div>
            <label>Course:</label>

            <input
                type="text"
                name="course"
                required
            >
        </div>

        <br>

        <div>
            <label>Email:</label>

            <input
                type="email"
                name="email"
                required
            >
        </div>

        <br>

        <button type="submit">
            Add Student
        </button>

    </form>

    <br>

    <a href="/students">
        ← Back to Students
    </a>

</body>
</html>